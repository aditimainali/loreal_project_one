# GEMINI_API_KEY: Required for built-in Gemini AI API calls when no Cloudflare Worker is set.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLOUDFLARE_WORKER_URL: Optional server-side Cloudflare Worker (*.workers.dev) endpoint for OpenAI gpt-4.1.
# CLOUDFLARE_WORKER_URL="https://loreal-routine-advisor-worker.your-subdomain.workers.dev/"

# VITE_CLOUDFLARE_WORKER_URL: Optional public Cloudflare Worker (*.workers.dev) endpoint called directly from the browser.
# VITE_CLOUDFLARE_WORKER_URL="https://loreal-routine-advisor-worker.your-subdomain.workers.dev/"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
